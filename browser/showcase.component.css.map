
    :host{display:block;--ink:#17233c;--muted:#8491a6;--line:#e8edf5;--surface:#fff;--blue:#2863e9}
    .page-wrap{max-width:1500px;margin:0 auto;padding:30px 34px 42px;color:var(--ink)}
    .page-heading{display:flex;align-items:center;justify-content:space-between;gap:18px;margin-bottom:24px}
    .page-heading h1{font-size:28px;margin:8px 0 6px;letter-spacing:-.4px}
    .page-heading p,.panel-head p{margin:0;color:var(--muted);font-size:12px}
    .eyebrow{font-size:11px;font-weight:800;color:#6483ce}
    .date-chip,.soft-chip{white-space:nowrap;background:#fff;border:1px solid var(--line);border-radius:11px;padding:10px 13px;color:#63718a;font-size:11px;font-weight:700}
    .stats-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin:20px 0}
    .stat-card,.panel,.state-card,.compare-card{background:var(--surface);border:1px solid var(--line);border-radius:16px}
    .stat-card{padding:17px;display:flex;align-items:center;gap:13px;min-width:0}
    .stat-icon{width:44px;height:44px;border-radius:13px;display:grid;place-items:center;font-size:19px;flex:none}
    .stat-icon.blue{background:#eaf0ff;color:#2863e9}.stat-icon.purple{background:#f1eaff;color:#8859dc}.stat-icon.green{background:#e5f8ef;color:#20a46b}.stat-icon.orange{background:#fff1df;color:#e99731}
    .stat-card small,.stat-card em{display:block;color:var(--muted);font-size:10px;font-style:normal}.stat-card b{display:block;font-size:22px;margin:3px 0}.stat-card em{font-size:9px}.up{color:#16976a!important}.down{color:#d88d27!important}
    .dashboard-grid{display:grid;grid-template-columns:1.6fr 1fr;gap:16px}.panel{padding:20px;min-width:0}
    .panel-head{display:flex;align-items:center;justify-content:space-between;gap:12px}.panel-head h2,.panel h2{font-size:16px;margin:0 0 6px}.chart-legend{display:flex;gap:18px;margin:20px 0 10px;color:#7b879c;font-size:10px}.chart-legend span{display:flex;align-items:center;gap:6px}.chart-legend i,.dot{display:inline-block;width:8px;height:8px;border-radius:50%}.legend-blue,.blue-dot{background:#3475f6}.legend-mint{background:#76d9b3}
    .bar-chart{height:210px;display:flex;gap:10px;padding-top:10px}.chart-y{display:flex;flex-direction:column;justify-content:space-between;color:#a5afbf;font-size:9px;padding-bottom:24px}.chart-bars{flex:1;display:flex;justify-content:space-around;align-items:stretch;border-bottom:1px solid #edf0f5;background:repeating-linear-gradient(to bottom,transparent 0,transparent 41px,#f0f2f7 42px)}.bar-group{height:100%;display:flex;flex-direction:column;justify-content:flex-end;align-items:center;gap:8px;min-width:20px}.bar-pair{height:calc(100% - 21px);display:flex;align-items:flex-end;gap:4px}.bar-pair i{display:block;width:13px;border-radius:5px 5px 1px 1px;min-height:8px}.bar-new{background:linear-gradient(#4d82f4,#2863e9)}.bar-done{background:#a9e8d0}.bar-group small{height:14px;color:#8b97aa;font-size:9px;white-space:nowrap}
    .donut-wrap{display:grid;place-items:center;padding:14px 0}.donut{width:148px;height:148px;border-radius:50%;display:grid;place-items:center;background:conic-gradient(#3674f5 0 80.6%,#9d80ed 80.6% 93%,#f2b651 93% 100%);position:relative}.donut:before{content:"";position:absolute;inset:13px;border-radius:50%;background:var(--surface)}.donut>div{z-index:1;text-align:center}.donut b,.donut small{display:block}.donut b{font-size:20px}.donut small{color:var(--muted);font-size:10px}.status-legend{display:grid;gap:10px}.status-legend span{display:flex;align-items:center;gap:8px;color:#69768c;font-size:10px}.status-legend b{margin-right:auto;color:var(--ink)}.purple-dot{background:#9d80ed}.orange-dot{background:#f2b651}.more-dots{color:#9aa6b7;letter-spacing:2px}
    .section-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:28px 0 14px}.section-head h2{font-size:18px;margin:5px 0 0}.text-link,.row-link{color:var(--blue);font-size:11px;font-weight:800;text-decoration:none}.subtle-note{font-size:10px;color:var(--muted)}
    .table-card{padding:0;overflow:auto}.table-card table{width:100%;border-collapse:collapse;white-space:nowrap}.table-card th,.table-card td{text-align:right;padding:14px 16px;border-bottom:1px solid #eef1f6;font-size:10px}.table-card th{background:#f8faff;color:#7b879c}.table-card td{color:#59667b}.table-card tr:last-child td{border:0}.id-cell{color:var(--blue)!important;font-weight:800}
    .status{display:inline-flex;border-radius:20px;padding:6px 9px;font-size:9px;font-weight:800}.status.completed{background:#e5f8ef;color:#199563}.status.in-progress{background:#eaf0ff;color:#2863e9}.status.pending{background:#fff4df;color:#b87919}.status.rejected{background:#fff0f0;color:#cf4444}
    .state-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.state-card{padding:18px;min-height:185px;display:flex;flex-direction:column;align-items:flex-start;justify-content:center}.state-card>b{font-size:12px;margin:12px 0 4px}.state-card p{font-size:10px;color:var(--muted);margin:0 0 10px}.state-icon{width:34px;height:34px;border-radius:11px;display:grid;place-items:center;font-size:17px}.empty-icon{background:#edf3ff;color:#4978db}.error-icon{background:#fff0f0;color:#d95050;font-weight:900}.state-action{font-size:9px;color:#6483ce}.spinner{width:28px;height:28px;border:3px solid #e8eef9;border-top-color:#3674f5;border-radius:50%;animation:spin 1s linear infinite}.skeleton-line{height:6px;width:75%;border-radius:9px;background:linear-gradient(90deg,#edf0f6,#f8f9fc,#edf0f6);margin:4px 0}.skeleton-line.short{width:52%}@keyframes spin{to{transform:rotate(360deg)}}
    .breadcrumbs{font-size:10px;color:var(--muted)}.breadcrumbs a{color:var(--blue);text-decoration:none}.breadcrumbs span{padding:0 8px;color:#c5ccda}
    .detail-layout{display:grid;grid-template-columns:minmax(0,1.7fr) minmax(260px,.8fr);gap:16px}.detail-main,.detail-aside{display:grid;align-content:start;gap:16px}.request-hero{display:flex;align-items:center;gap:17px;background:linear-gradient(120deg,#fff,#f7f9ff)}.large-device{width:68px;height:68px;margin:0;flex:none}.request-title{flex:1}.request-title h2{margin:6px 0;font-size:19px}.request-title p{font-size:10px;color:var(--muted);margin:0}.request-total{border-right:1px solid var(--line);padding-right:18px}.request-total small,.request-total b{display:block}.request-total small,.estimate-card small{font-size:9px;color:var(--muted)}.request-total b{font-size:21px;margin-top:5px}.request-total b small{display:inline;font-size:11px}
    .progress{height:7px;background:#e9edf5;border-radius:20px;overflow:hidden}.progress i{display:block;width:65%;height:100%;border-radius:inherit;background:linear-gradient(90deg,#5790ff,#2863e9)}.progress-value{font-size:13px;font-weight:900;color:var(--blue)}.timeline-panel>.progress{margin:17px 0 22px}
    .detail-timeline{position:relative}.detail-timeline:before{content:"";position:absolute;right:14px;top:18px;bottom:27px;width:2px;background:#e5eaf2}.detail-step{position:relative;display:flex;gap:14px;padding:0 0 19px}.detail-step:last-child{padding-bottom:0}.detail-step>span{z-index:1;width:30px;height:30px;display:grid;place-items:center;border-radius:50%;background:#f1f4f9;color:#98a4b7;font-size:11px;font-weight:800;flex:none}.detail-step.completed>span{background:#e3f8ef;color:#1d9a68}.detail-step.active>span{background:#eaf0ff;color:var(--blue);box-shadow:0 0 0 4px #f4f7ff}.detail-step b,.detail-step small{display:block}.detail-step b{font-size:11px}.detail-step small{font-size:9px;color:var(--muted);margin-top:3px}.detail-step p{font-size:10px;color:#718098;margin:6px 0 0}.issue-copy{font-size:11px;line-height:2;color:#64718a}.info-tags{display:flex;flex-wrap:wrap;gap:8px}.info-tags span{padding:7px 9px;background:#f5f7fb;border-radius:8px;color:#69768b;font-size:9px}
    .center-summary .center-identity{margin:15px 0}.center-identity{display:flex;align-items:center;gap:11px}.center-logo{display:grid;place-items:center;width:45px;height:45px;border-radius:14px;background:linear-gradient(145deg,#edf3ff,#e3ebff);color:#2863e9;font-size:23px;flex:none}.center-identity b,.center-identity small{display:block}.center-identity b{font-size:12px}.center-identity small{margin-top:4px;color:#149468;font-size:9px}.verified{color:#159467;background:#e8f8ef;border-radius:15px;padding:4px 7px}.center-summary>p{font-size:10px;color:var(--muted)}.rating{font-size:11px;color:#e5a22b}.rating span{font-size:9px;color:var(--muted)}.btn{display:inline-flex;align-items:center;justify-content:center;text-decoration:none;border:1px solid var(--line);border-radius:10px;padding:10px 14px;font-size:10px;font-weight:800;cursor:pointer}.btn.full{width:100%;margin-top:15px}.btn.ghost{color:#4d5c75;background:#fff}
    .estimate-card>div{display:flex;justify-content:space-between;gap:10px;padding:11px 0;border-bottom:1px solid #eef1f6;font-size:10px;color:#637087}.estimate-card>div b{color:var(--ink)}.estimate-card .estimate-total{font-size:12px;font-weight:800;border-bottom:0}.estimate-card>small{display:block;margin-top:7px}.note-card h3{font-size:12px;margin:12px 0 5px}.note-card p{font-size:10px;color:var(--muted);line-height:1.8;margin:0}
    .compare-highlight{display:flex;justify-content:space-between;align-items:center;gap:15px;padding:22px 24px;border-radius:18px;background:linear-gradient(115deg,#183b88,#3475ee);color:white;margin-bottom:18px}.compare-highlight .eyebrow{color:#c4d8ff}.compare-highlight h2{font-size:19px;margin:8px 0}.compare-highlight p{color:#d4e1ff;font-size:10px;margin:0}.highlight-metrics{display:flex;gap:22px}.highlight-metrics span{border-right:1px solid #ffffff45;padding-right:19px}.highlight-metrics small,.highlight-metrics b{display:block}.highlight-metrics small{font-size:9px;color:#c6d8ff}.highlight-metrics b{font-size:17px;margin-top:5px}.highlight-metrics i{font-style:normal;color:#ffc75f}
    .compare-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.compare-card{position:relative;padding:20px}.compare-card.recommended{border:1.5px solid #6c95f2;box-shadow:0 10px 28px #2863e914}.recommend-label{position:absolute;left:14px;top:14px;background:#edf3ff;color:#2863e9;border-radius:20px;padding:6px 9px;font-size:9px;font-weight:800}.compare-price{font-size:26px;font-weight:900;margin:23px 0 4px}.compare-price small{font-size:10px;color:var(--muted)}.compare-facts{display:grid;gap:10px;padding:15px 0;border-top:1px solid #edf0f5;margin-top:15px}.compare-facts span{display:flex;justify-content:space-between;color:var(--muted);font-size:10px}.compare-facts b{color:#35415a}.compare-foot{font-size:9px;color:#667893}.comparison-table{margin-top:16px}
    .device-detail-grid{display:grid;grid-template-columns:1.35fr 1fr;gap:16px}.device-profile{padding:0;overflow:hidden}.device-cover{min-height:155px;display:grid;place-items:center;position:relative;overflow:hidden;background:radial-gradient(circle at 50% 20%,#fff 0,#e6eeff 70%,#d9e5ff 100%)}.device-hero-icon{position:relative;z-index:1;width:90px;height:90px;border-radius:27px;font-size:44px;background:#fff;box-shadow:0 15px 35px #315eaa24}.cover-orbit{position:absolute;width:270px;height:270px;border:1px solid #9db7ed66;border-radius:50%;box-shadow:0 0 0 30px #ffffff30,0 0 0 60px #ffffff28}.device-profile-content{padding:22px}.device-profile-content h2{font-size:20px;margin:6px 0}.device-profile-content>p{font-size:11px;color:var(--muted)}.device-data{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;padding:18px 0}.device-data small,.device-data b{display:block}.device-data small{font-size:9px;color:var(--muted);margin-bottom:5px}.device-data b{font-size:11px}.blue-text{color:var(--blue)}.warranty-mini .panel-head{margin-bottom:20px}.warranty-progress{display:flex;justify-content:space-between;font-size:10px;color:#6d7a90;margin:10px 0}.warranty-progress b{color:var(--blue)}.warranty-mini>p{font-size:10px;color:var(--muted)}.history-list{display:grid;gap:12px}.history-card{display:flex;align-items:center;gap:13px}.history-icon{display:grid;place-items:center;width:38px;height:38px;border-radius:12px;flex:none}.completed-icon{background:#e5f8ef;color:#1b9d6b}.current-icon{background:#eaf0ff;color:var(--blue)}.history-main{flex:1}.history-main>div{display:flex;align-items:center;gap:9px}.history-main b{font-size:11px}.history-main p,.history-main small{font-size:9px;color:var(--muted);display:block;margin:5px 0 0}.history-price{font-size:11px}
    .center-cover{height:190px;border-radius:18px;position:relative;overflow:hidden;background:radial-gradient(ellipse at 75% 15%,#76a3ff 0,transparent 35%),linear-gradient(120deg,#16336e,#2d65d4 55%,#729bf0)}.center-cover:before,.center-cover:after{content:"";position:absolute;border:1px solid #ffffff30;border-radius:50%}.center-cover:before{width:360px;height:360px;left:-60px;top:-230px}.center-cover:after{width:250px;height:250px;right:12%;bottom:-190px}.cover-glow{position:absolute;width:160px;height:160px;border-radius:50%;background:#fff2;right:25%;top:15px;filter:blur(25px)}.cover-verified{position:absolute;bottom:17px;right:20px;font-size:10px}.center-profile-card{position:relative;margin:-28px 16px 17px;z-index:1;padding:20px 22px;box-shadow:0 12px 32px #1b315a0b}.profile-heading{display:flex;align-items:center;gap:16px}.profile-logo{width:66px;height:66px;font-size:31px;border:4px solid white;box-shadow:0 4px 15px #18376418}.profile-name{flex:1}.profile-name h1{font-size:20px;margin:5px 0}.profile-name p{font-size:10px;color:var(--muted);margin:0}.center-rating{text-align:center;border-right:1px solid var(--line);padding-right:20px}.center-rating b,.center-rating small{display:block}.center-rating b{font-size:19px}.center-rating i{font-style:normal;color:#e8a52f}.center-rating small{font-size:9px;color:var(--muted);margin-top:4px}.center-highlights{display:flex;flex-wrap:wrap;gap:20px;border-top:1px solid #eef1f6;margin-top:17px;padding-top:14px;color:#68768d;font-size:10px}.center-detail-grid{display:grid;grid-template-columns:1.5fr .8fr;gap:16px}.center-detail-main,.center-detail-aside{display:grid;align-content:start;gap:13px}.about-panel>p{font-size:11px;line-height:2;color:#69768b}.specialty-tags{display:flex;flex-wrap:wrap;gap:7px}.specialty-tags span{background:#edf3ff;color:#426fce;border-radius:18px;padding:7px 10px;font-size:9px}.customer-review{display:flex;align-items:flex-start;gap:12px}.review-avatar{display:grid;place-items:center;width:36px;height:36px;flex:none;border-radius:50%;background:#eaf0ff;color:#2863e9;font-weight:800}.violet-avatar{background:#f1eaff;color:#8859dc}.customer-review b{display:inline-block;font-size:11px;margin-left:9px}.customer-review .rating{font-size:9px}.customer-review p{font-size:10px;color:#6b788e;margin:6px 0}.customer-review small{font-size:9px;color:var(--muted)}.hours-panel>div,.service-panel>div{display:flex;justify-content:space-between;gap:9px;padding:11px 0;border-bottom:1px solid #eef1f6;font-size:9px;color:#6e7b90}.hours-panel>div b,.service-panel>div b{font-size:9px;color:#38465e}.service-panel>div small{display:block;font-size:8px;font-weight:400;color:var(--muted)}.open-chip{display:inline-block;margin-top:12px;padding:6px 9px;background:#e8f8ef;border-radius:16px;color:#168e60;font-size:9px}.service-panel>p{font-size:9px;color:var(--muted);line-height:1.8}
    :host-context(.dark-mode){--ink:#e5eaf4;--muted:#a8b5ca;--line:#26334a;--surface:#111a2d}
    :host-context(.dark-mode) .showcase{color:#e5eaf4}
    :host-context(.dark-mode) .showcase h1,:host-context(.dark-mode) .showcase h2,:host-context(.dark-mode) .showcase h3,:host-context(.dark-mode) .showcase b,:host-context(.dark-mode) .showcase td{color:#e5eaf4}
    :host-context(.dark-mode) .showcase p,:host-context(.dark-mode) .showcase small,:host-context(.dark-mode) .showcase .chart-y,:host-context(.dark-mode) .showcase .chart-legend,:host-context(.dark-mode) .showcase .status-legend span,:host-context(.dark-mode) .showcase .compare-facts span,:host-context(.dark-mode) .showcase .compare-foot,:host-context(.dark-mode) .showcase .center-highlights,:host-context(.dark-mode) .showcase .hours-panel>div,:host-context(.dark-mode) .showcase .service-panel>div,:host-context(.dark-mode) .showcase .warranty-progress,:host-context(.dark-mode) .showcase .breadcrumbs,:host-context(.dark-mode) .showcase .subtle-note{color:#a8b5ca}
    :host-context(.dark-mode) .showcase .issue-copy,:host-context(.dark-mode) .showcase .detail-step p,:host-context(.dark-mode) .showcase .about-panel>p,:host-context(.dark-mode) .showcase .customer-review p,:host-context(.dark-mode) .showcase .compare-facts b,:host-context(.dark-mode) .showcase .estimate-card>div b,:host-context(.dark-mode) .showcase .hours-panel>div b,:host-context(.dark-mode) .showcase .service-panel>div b,:host-context(.dark-mode) .showcase .device-data b,:host-context(.dark-mode) .showcase .history-main b{color:#d9e2f2}
    :host-context(.dark-mode) .showcase .table-card th{background:#172238;color:#c7d3e8}
    :host-context(.dark-mode) .showcase .table-card td{color:#d9e2f2}
    :host-context(.dark-mode) .showcase .info-tags span,:host-context(.dark-mode) .showcase .btn.ghost{background:#172238;color:#d3def2}
    :host-context(.dark-mode) .showcase .compare-highlight{color:white}
    :host-context(.dark-mode) .showcase .request-hero{background:linear-gradient(120deg,#111a2d,#172440)}
    :host-context(.dark-mode) .showcase .center-profile-card{box-shadow:0 12px 32px #0003}
    :host-context(.dark-mode) .showcase .empty-icon{color:#8db4ff}
    :host-context(.dark-mode) .showcase .invoice-parties span,:host-context(.dark-mode) .showcase .invoice-note p,:host-context(.dark-mode) .showcase .invoice-totals>div,:host-context(.dark-mode) .showcase .related-links a{color:#d9e2f2}
    :host-context(.dark-mode) .showcase .invoice-note,:host-context(.dark-mode) .showcase .technician-tags span{background:#172238}
    :host-context(.dark-mode) .showcase .help-search{background:#172238;color:#d3def2}
    :host-context(.dark-mode) .showcase .calendar-grid>span:not(.selected-day){background:#172238;color:#e5eaf4}
    :host-context(.dark-mode) .showcase .calendar-grid>.faded-day{background:transparent;color:#7888a2}
    :host-context(.dark-mode) .showcase .map-placeholder{background-color:#172238;color:#d3def2}
