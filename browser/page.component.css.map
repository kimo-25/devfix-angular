mplate-columns:1fr .75fr}.hero h1{font-size:34px}.stats-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.feature-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.center-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.device-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:760px){.page-wrap{padding:20px 14px 30px}.hero{grid-template-columns:1fr;padding:27px 22px}.hero h1{font-size:32px}.hero-art{min-height:270px;margin-top:12px}.hero-art .orbit{width:240px;height:240px}.hero-art .orbit-two{width:190px;height:190px}.stats-grid,.stats-grid.compact{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.stat-card{padding:13px;gap:9px}.stat-icon{width:35px;height:35px}.stat-card b{font-size:17px}.feature-grid,.center-grid,.device-grid,.request-grid{grid-template-columns:1fr}.section-head h2{font-size:17px}.page-heading{align-items:flex-start}.page-heading h1{font-size:23px}.page-heading .btn{padding:10px;font-size:10px}.filter-panel{flex-wrap:wrap}.search-box{flex-basis:100%}.filter-panel select{flex:1;max-width:none}.wizard-layout{grid-template-columns:1fr}.request-help{display:none}.wizard-panel{padding:17px}.steps{gap:3px}.step{flex-direction:column;gap:5px}.step small{font-size:8px}.choice-grid{grid-template-columns:repeat(3,1fr)}.choice{padding:10px 4px}.choice small{font-size:8px}.bid-grid{grid-template-columns:1fr}.bid-intro{align-items:flex-start;gap:10px;flex-direction:column}.tracking-title{flex-wrap:wrap}.tracking-title>.status{margin-right:0}.timeline-item>.status{display:none}.two-col{grid-template-columns:1fr}.full-span{grid-column:auto}.auth-layout{grid-template-columns:1fr;margin:0}.auth-art{min-height:auto;padding:27px}.auth-art h1{font-size:22px}.auth-panel{padding:25px}.review-hero{gap:12px;padding:17px}.review-score{padding:10px}.review-score b{font-size:23px}.table-card{overflow-x:auto}.table-card table{min-width:650px}footer{flex-direction:column}.wallet-hero h2{font-size:26px}.bars{gap:5px}.bars i{width:20px}}
  /* DevFix premium visual system */
  :host{color:var(--ink,#17233c)}
  .page-wrap{max-width:1600px;padding:34px clamp(18px,3vw,46px) 48px;background:radial-gradient(ellipse at 90% 0%,rgba(37,99,235,.045),transparent 35%)}
  .hero{border-radius:28px;padding:clamp(28px,4vw,54px);min-height:370px;background:linear-gradient(118deg,#101e42 0%,#173b87 48%,#2563eb 100%);box-shadow:0 22px 55px rgba(23,59,135,.18)}
  .hero:before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 74% 25%,rgba(126,170,255,.28),transparent 26%),linear-gradient(115deg,transparent 55%,rgba(255,255,255,.035));pointer-events:none}
  .hero:after{width:470px;height:470px;border-color:#ffffff17;left:-170px;bottom:-320px}
  .hero h1{font-size:clamp(34px,3.3vw,50px);line-height:1.3;letter-spacing:-1.4px}
  .hero p{font-size:14px;line-height:2.1;color:#dbe7ff}
  .hero .eyebrow{background:rgba(255,255,255,.09);border:1px solid rgba(255,255,255,.12);backdrop-filter:blur(8px)}
  .hero .btn{min-height:46px;padding-inline:20px;border-radius:12px}
  .hero .btn.primary{box-shadow:0 9px 24px rgba(3,18,56,.2)}
  .device-card{border-radius:30px;box-shadow:0 28px 70px rgba(2,13,42,.25);backdrop-filter:blur(15px)}
  .float-tag{border:1px solid #e8eeff;border-radius:14px;padding:12px 15px;box-shadow:0 14px 35px rgba(9,29,77,.2)}
  .stats-grid{gap:16px;margin:24px 0 38px}
  .stat-card{border-radius:18px;padding:21px;border-color:#e8edf6;box-shadow:0 5px 18px rgba(19,39,78,.025);transition:transform .22s,box-shadow .22s,border-color .22s}
  .stat-card:hover{transform:translateY(-3px);box-shadow:0 14px 28px rgba(25,55,115,.07);border-color:#d5e1fb}
  .stat-icon{width:48px;height:48px;border-radius:15px}
  .stat-card small{font-size:11px;color:#75829a}
  .stat-card b{font-size:23px;letter-spacing:-.5px}
  .section-head{margin:36px 0 17px}
  .section-head h2,.page-heading h1{letter-spacing:-.5px}
  .section-head h2{font-size:21px}
  .page-heading{margin-bottom:28px;padding:0 0 22px;border-bottom:1px solid #e8edf5}
  .page-heading h1{font-size:30px;margin:12px 0 7px}
  .page-heading p{font-size:13px;line-height:1.9;color:#7d8aa1}
  .breadcrumbs{font-size:11px;color:#9aa6b9}
  .btn{border-radius:12px;min-height:40px;box-shadow:none}
  .btn.primary{background:linear-gradient(135deg,#3475f6,#2457d7);box-shadow:0 6px 14px rgba(37,99,235,.15)}
  .btn.primary:hover{box-shadow:0 10px 22px rgba(37,99,235,.22);filter:none}
  .btn.ghost{background:#fff;border-color:#e3e9f3;color:#4d5c75}
  .feature-grid{gap:16px}
  .feature-card{border-radius:18px;padding:22px;border-color:#e8edf6;box-shadow:0 5px 18px rgba(19,39,78,.02);transition:transform .22s,border-color .22s,box-shadow .22s}
  .feature-card:hover{transform:translateY(-4px);border-color:#cddcff;box-shadow:0 16px 30px rgba(35,75,150,.08)}
  .feature-icon{width:48px;height:48px;border-radius:15px;display:grid;place-items:center;background:#edf3ff;color:#2c63df}
  .feature-card h3{font-size:15px;margin:18px 0 8px}
  .feature-card p{font-size:12px;line-height:1.9;color:#7f8ba0}
  .panel,.table-card,.form-card,.center-card,.bid-card,.review-card,.device-tile,.request-card{border-radius:17px;border-color:#e7edf6;box-shadow:0 5px 20px rgba(19,39,78,.025)}
  .panel{padding:23px}
  .table-card{overflow:hidden}
  table{border-collapse:separate;border-spacing:0;width:100%}
  th{font-size:10px;letter-spacing:.1px;padding:15px 18px;background:#f7f9fd;color:#7c8aa2;border-bottom:1px solid #e9eef6}
  td{font-size:11px;padding:16px 18px;border-bottom:1px solid #edf1f7}
  tbody tr:last-child td{border-bottom:0}
  tbody tr:hover td{background:#fafcff}
  .status{padding:6px 10px;border-radius:999px;font-size:10px;font-weight:800;white-space:nowrap}
  .search-box,input,select,textarea{border-radius:11px}
  input,select,textarea{border-color:#e0e7f1!important;background:#fbfcff!important;transition:border-color .18s,box-shadow .18s}
  input:focus,select:focus,textarea:focus{outline:none;border-color:#7ba2ff!important;box-shadow:0 0 0 3px rgba(52,117,246,.11)}
  .filter-panel{border-radius:16px;border:1px solid #e8edf5;background:#fff;padding:14px;box-shadow:0 5px 20px rgba(19,39,78,.025);gap:10px}
  .center-grid{gap:17px}
  .center-card{padding:22px;transition:transform .2s,box-shadow .2s,border-color .2s}
  .center-card:hover{transform:translateY(-3px);border-color:#d1def8;box-shadow:0 15px 32px rgba(28,60,120,.07)}
  .center-logo{border-radius:15px;background:linear-gradient(145deg,#edf3ff,#e4ebff)}
  .verified{border-radius:999px;padding:6px 9px;background:#e8f8ef;color:#18875c}
  .rating{color:#e5a22b}
  .wizard-layout{gap:20px}
  .wizard-panel,.request-help{border-radius:18px}
  .steps{padding-bottom:20px;border-bottom:1px solid #edf1f7}
  .step span{box-shadow:0 0 0 4px #f4f6fb}
  .step.current span{box-shadow:0 0 0 4px #e7efff}
  .choice{border-radius:14px;border-color:#e5ebf4;transition:.18s}
  .choice:hover,.choice.selected{border-color:#5f8df5;background:#f3f7ff;box-shadow:0 0 0 3px rgba(52,117,246,.07)}
  .upload-box{border-radius:14px;border:1px dashed #b9c9e7;background:#f8faff}
  .timeline-panel,.tracking-overview{border-radius:18px}
  .timeline:before{background:linear-gradient(#3b76f4,#dce5f5)}
  .review-score{background:linear-gradient(145deg,#f7f9ff,#edf3ff);border:1px solid #e4ebfb}
  .wallet-hero,.warranty-banner{border-radius:20px;box-shadow:0 16px 36px rgba(24,58,132,.12)}
  .wallet-hero{background:radial-gradient(circle at 15% 10%,#416ec2,transparent 34%),linear-gradient(120deg,#122344,#1e4b9d)}
  .auth-layout{gap:22px}
  .auth-art{border-radius:24px;background:radial-gradient(circle at 80% 10%,rgba(117,165,255,.4),transparent 30%),linear-gradient(145deg,#132b5f,#2868e8);box-shadow:0 20px 50px rgba(23,59,135,.13)}
  .auth-panel{border:1px solid #e8edf6;border-radius:24px;box-shadow:0 15px 45px rgba(20,43,83,.05)}
  .notice{border-radius:12px;box-shadow:0 8px 22px rgba(20,43,83,.04)}
  .text-link,.row-link{font-weight:800}
  .empty-results{grid-column:1/-1;display:grid;justify-items:center;gap:8px;padding:36px 18px;background:#fff;border:1px dashed #d5deed;border-radius:16px;text-align:center;color:#7e8ba1}
  .empty-results>span{display:grid;place-items:center;width:42px;height:42px;border-radius:14px;background:#edf3ff;color:#2863e9;font-size:23px}
  .empty-results>b{font-size:13px;color:#394760}
  .empty-results>p{font-size:10px;margin:0}
  .dark-mode .empty-results{background:#111a2d;border-color:#33415b;color:#a8b5ca}
  .dark-mode .empty-results>b{color:#e5eaf4}
  .workflow-shortcuts{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin:0 0 18px;padding:10px 12px;border:1px solid #e6ebf4;border-radius:12px;background:#fff}
  .workflow-shortcuts a{display:inline-flex;align-items:center;padding:8px 10px;border-radius:8px;background:#f2f6ff;color:#2863e9;font-size:10px;font-weight:800;text-decoration:none;transition:background .18s}
  .workflow-shortcuts a:hover{background:#e5edff}
  .dark-mode .workflow-shortcuts{background:#111a2d;border-color:#26334a}
  .dark-mode .workflow-shortcuts a{background:#1a2943;color:#a9c5ff}
  @media(max-width:650px){.workflow-shortcuts{gap:6px;padding:9px}.workflow-shortcuts a{flex:1 1 calc(50% - 6px);justify-content:center;text-align:center}.filter-panel{flex-wrap:wrap}.filter-panel>*{min-width:0}.filter-panel .search-box{flex-basis:100%}.device-grid,.center-grid,.bid-grid,.request-grid{grid-template-columns:1fr}.stats-grid.compact{grid-template-columns:repeat(2,minmax(0,1fr))}.table-card{max-width:100%;overflow-x:auto;-webkit-overflow-scrolling:touch}.page-heading{align-items:flex-start}.tile-actions{flex-wrap:wrap}.tile-actions .btn{flex:1}.form-end{grid-column:1/-1}}
  @media(max-width:380px){.workflow-shortcuts a{flex-basis:100%}.page-wrap{padding-right:12px;padding-left:12px}.hero{padding:26px 20px}.hero h1{font-size:30px}.trust-row{gap:9px}.stats-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.stat-card{padding:12px;gap:8px}.filter-panel select,.filter-panel>.btn{flex:1 1 100%;width:100%}}
  @media(max-width:760px){.page-wrap{padding:20px 15px 30px}.hero{border-radius:22px;min-height:unset}.hero h1{font-size:34px}.stats-grid{margin-bottom:28px}.stat-card{border-radius:15px}.page-heading{gap:12px}.page-heading h1{font-size:25px}.panel{padding:17px}.feature-card{padding:18px}}
  @media(prefers-reduced-motion:reduce){*,*:before,*:after{transition:none!important;animation:none!important}}
